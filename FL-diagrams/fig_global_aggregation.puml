@startuml
title 9.8.8 Global Aggregation\nand Updated Model Publication

hide footbox

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center

skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ParticipantBorderColor #333333
    ParticipantBackgroundColor white
    ParticipantFontStyle bold
    DividerBorderColor #777777
    DividerBackgroundColor white
    DividerFontStyle bold
    GroupBorderColor #777777
    GroupBackgroundColor white
    NoteBorderColor #777777
    NoteBackgroundColor #FFFDF5
}

legend top left
  X = 1..N (factory index)

  CIN    : contentInstance
  FedAvg : Federated Averaging

  Mca : AE-CSE reference point
  Mcc : CSE-CSE reference point
endlegend

box "Factory X" #EAF2FC
participant "MN-AE-X" as MNAE
participant "MN-CSE-X" as MNCSE
end box

box "Cloud Service Platform" #FFF8E7
participant "IN-CSE" as INCSE
participant "IN-AE" as INAE
end box


== Local Update Notification Collection ==

loop for each factory X = 1..N
    INCSE -> INAE : 1. NOTIFY local-update arrival\nfrom cnt-mnX
    INAE --> INCSE : 2. NOTIFY Response\n2000 OK
end

INAE -> INAE : 3. Wait for expected updates\nor collection deadline


== Local Update Retrieval ==

loop for each factory X = 1..N
    INAE -> INCSE : 4. RETRIEVE local-update <CIN>\nfrom cnt-mnX
    INCSE --> INAE : 5. RETRIEVE Response
end


== Local Update Validation ==

loop for each retrieved local update X = 1..N
    INAE -> INAE : 6. Validate update metadata
    INAE -> INAE : 7. Download and verify\nlocal weights
end


== Update Anomaly Detection ==

INAE -> INAE : 8. Detect anomalous updates


== Global Model Aggregation ==

INAE -> INAE : 9. Apply FedAvg


== Updated Global Model Publication ==

INAE -> INAE : 10. Store aggregated global model
INAE -> INCSE : 11. CREATE global-model <CIN>\nunder cnt-global-model
INCSE --> INAE : 12. CREATE Response\n2001 CREATED


== Next-Round or Completion Command Publication ==

INAE -> INCSE : 13. CREATE next-round or\ncompletion command <CIN>
INCSE --> INAE : 14. CREATE Response\n2001 CREATED


== Cross-CSE Command Notification ==

loop for each factory X = 1..N
    INCSE -> MNCSE : 15. NOTIFY next-round or\ncompletion command
    MNCSE -> MNAE : 16. Forward NOTIFY via Mca
    MNAE --> MNCSE : 17. NOTIFY Response\n2000 OK
    MNCSE --> INCSE : 18. Forward NOTIFY Response
end


== START_NEXT_ROUND Continuation ==

note over MNAE, INAE
Steps 19 to 25 apply to START_NEXT_ROUND only.
For FL_COMPLETED, processing ends after Step 18.
end note

loop for each factory X = 1..N
    MNAE -> MNCSE : 19. RETRIEVE updated\nglobal model
    MNCSE -> INCSE : 20. Forward RETRIEVE via Mcc
    INCSE --> MNCSE : 21. RETRIEVE Response
    MNCSE --> MNAE : 22. Forward RETRIEVE Response

    MNAE -> MNAE : 23. Download and verify\nupdated global model

    MNAE -> MNCSE : 24. CREATE cached-model <CIN>\nunder cnt-local-model
    MNCSE --> MNAE : 25. CREATE Response\n2001 CREATED
end

@enduml