@startuml
title Initial Setup Procedures\nClauses 9.8.2 to 9.8.6

hide footbox

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center

skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ParticipantBorderColor #333333
    ParticipantBackgroundColor white
    ParticipantFontStyle bold
    DividerBorderColor #777777
    DividerBackgroundColor white
    DividerFontStyle bold
    GroupBorderColor #777777
    GroupBackgroundColor white
    NoteBorderColor #777777
    NoteBackgroundColor #FFFDF5
}

legend top left
  i = 1..N (factory index)

  AE  : Application Entity
  CSR : remoteCSE
  ACP : accessControlPolicy
  CNT : container
  SUB : subscription

  Mca : AE-CSE reference point
  Mcc : CSE-CSE reference point
endlegend

box "Factory i" #EAF2FC
participant "ADN-AE[i]" as ADN
participant "MN-AE[i]" as MNAE
participant "MN-CSE[i]" as MNCSE
end box

box "Cloud Service Platform" #FFF8E7
participant "IN-CSE" as INCSE
participant "IN-AE" as INAE
end box


== 9.8.2 MN-CSE Registration ==

loop for each factory i = 1..N
    MNCSE -> INCSE : CREATE <remoteCSE>\nMN-CSE[i] registration via Mcc
    INCSE --> MNCSE : CREATE Response\n2001 CREATED

    MNCSE -> INCSE : RETRIEVE <CSEBase>\nIN-CSE information
    INCSE --> MNCSE : RETRIEVE Response\nIN-CSE identifiers and addressing information

    MNCSE -> MNCSE : Create counterpart <remoteCSE>\nrepresenting IN-CSE locally
end


== 9.8.3 Application Entities Registration ==

loop 9.8.3.1 ADN-AE-X, i = 1..N
    ADN -> MNCSE : CREATE <AE>\nADN-AE[i] via Mca
    MNCSE --> ADN : CREATE Response\n2001 CREATED
end

loop 9.8.3.2 MN-AE-X, i = 1..N
    MNAE -> MNCSE : CREATE <AE>\nMN-AE[i] via Mca
    MNCSE --> MNAE : CREATE Response\n2001 CREATED
end

INAE -> INCSE : 9.8.3.3 CREATE <AE>\nIN-AE via Mca
INCSE --> INAE : CREATE Response\n2001 CREATED


== 9.8.4 Access Control Policy Creation ==

INAE -> INCSE : 9.8.4.1 CREATE <ACP>\nrn = acp-fl-control\nIN-AE: 15\nMN-AE[i]: 3
INCSE --> INAE : CREATE Response\n2001 CREATED

INAE -> INCSE : CREATE <ACP>\nrn = acp-global-model\nIN-AE: 15\nMN-AE[i]: 2
INCSE --> INAE : CREATE Response\n2001 CREATED

loop Create one local-update ACP per factory, i = 1..N
    INAE -> INCSE : CREATE <ACP>\nrn = acp-local-update-mn[i]\nIN-AE: 3\nMN-AE[i]: 1
    INCSE --> INAE : CREATE Response\n2001 CREATED
end

loop 9.8.4.2 Local ACP creation, i = 1..N
    MNAE -> MNCSE : CREATE <ACP>\nrn = acp-sensor-data-i\nADN-AE[i]: 15\nMN-AE[i]: 3
    MNCSE --> MNAE : CREATE Response\n2001 CREATED

    MNAE -> MNCSE : CREATE <ACP>\nrn = acp-local-model-i\nMN-AE[i]: 15
    MNCSE --> MNAE : CREATE Response\n2001 CREATED
end


== 9.8.5 Containers Creation ==

loop 9.8.5.1 Local containers, i = 1..N
    ADN -> MNCSE : CREATE <CNT>\nunder ADN-AE[i]\nrn = cnt-sensor-data\nacpi = acp-sensor-data-i
    MNCSE --> ADN : CREATE Response\n2001 CREATED

    MNAE -> MNCSE : CREATE <CNT>\nunder MN-AE[i]\nrn = cnt-local-model\nacpi = acp-local-model-i
    MNCSE --> MNAE : CREATE Response\n2001 CREATED
end

INAE -> INCSE : 9.8.5.2 CREATE <CNT>\nunder IN-AE\nrn = cnt-fl-control\nacpi = acp-fl-control
INCSE --> INAE : CREATE Response\n2001 CREATED

INAE -> INCSE : CREATE <CNT>\nunder IN-AE\nrn = cnt-global-model\nacpi = acp-global-model
INCSE --> INAE : CREATE Response\n2001 CREATED

INAE -> INCSE : CREATE <CNT>\nunder IN-AE\nrn = cnt-local-updates
INCSE --> INAE : CREATE Response\n2001 CREATED

loop Create one child container per factory, i = 1..N
    INAE -> INCSE : CREATE <CNT>\nunder cnt-local-updates\nrn = cnt-mn[i]\nacpi = acp-local-update-mn[i]
    INCSE --> INAE : CREATE Response\n2001 CREATED
end


== 9.8.6.1 sub-sensor-data — Local Subscription ==

loop for each factory i = 1..N
    MNAE -> MNCSE : CREATE <SUB>\nunder ADN-AE[i]/cnt-sensor-data\nrn = sub-sensor-data-i\nnu = MN-AE[i]\nnet = 3
    MNCSE --> MNAE : CREATE Response\n2001 CREATED
end

note over ADN, MNCSE
The subscription request and subsequent notifications
remain within MN-CSE[i].
end note


== 9.8.6.2 sub-fl-control-mnX — Cross-CSE Subscription ==

loop for each factory i = 1..N
    MNAE -> MNCSE : CREATE <SUB>\ntarget = IN-AE/cnt-fl-control\nrn = sub-fl-control-mn[i]\nnu = MN-AE[i]\nnet = 3

    MNCSE -> INCSE : Forward CREATE via Mcc\ntarget = IN-AE/cnt-fl-control

    INCSE --> MNCSE : CREATE Response\n2001 CREATED
    MNCSE --> MNAE : Forward CREATE Response
end

note over MNAE, INCSE
The subscription resource is hosted under
cnt-fl-control on the IN-CSE.

Subsequent notifications are routed through:
IN-CSE → MN-CSE[i] via Mcc
MN-CSE[i] → MN-AE[i] via Mca
end note


== 9.8.6.3 sub-in-dropbox-mnX — Local Subscription ==

loop for each factory dropbox i = 1..N
    INAE -> INCSE : CREATE <SUB>\nunder cnt-local-updates/cnt-mn[i]\nrn = sub-in-dropbox-mn[i]\nnu = IN-AE\nnet = 3
    INCSE --> INAE : CREATE Response\n2001 CREATED
end

note over INCSE, INAE
The subscription request and subsequent local-update
notifications remain within the IN-CSE.
end note


note over ADN, INAE
Initial setup complete.

Registration, ACP, container and subscription resources
are reused across multiple federated-learning rounds.
end note

@enduml